# Tauri 2 file-watcher ignore list (gitignore syntax). The backend only writes
# data/ and logs/ here when the sidecar is run directly from this folder; without
# this, `tauri dev` would then rebuild and restart the app on every write.
data/
logs/

# Sidecar binary + its PyInstaller `_internal/` dir are written/refreshed by
# the build pipeline, not Rust source.
_internal/
geti-backend-*
