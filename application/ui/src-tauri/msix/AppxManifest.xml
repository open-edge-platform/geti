<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

    <!--
        This file is a TEMPLATE. The `Version` attribute below is a placeholder:
        `build_msix.py` overwrites it at packaging time with the release version
        (single source of truth: ui/src-tauri/tauri.conf.json), normalised to the
        MSIX 4-part `Major.Minor.Build.Revision` form. The `Name` and `Publisher`
        MUST stay constant across releases so Windows performs an in-place upgrade
        (keeping the per-user data directory) instead of a side-by-side install.
    -->
    <Identity Name="intel.geti" Publisher="CN=Intel Corporation, O=Intel Corporation, S=California, C=US" Version="0.0.0.0"/>

    <Properties>
        <DisplayName>Intel Geti</DisplayName>
        <PublisherDisplayName>Intel</PublisherDisplayName>
        <Description>Geti by Intel</Description>
        <Logo>Assets\logo.png</Logo>
    </Properties>

    <Resources>
        <Resource Language="en-us"/>
    </Resources>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.15063.0" MaxVersionTested="10.0.19045.0"/>
    </Dependencies>

    <Applications>
        <Application Id="Geti" Executable="geti_ui.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements BackgroundColor="transparent" DisplayName="Intel Geti"
                                Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
                                Description="Geti by Intel">
                <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
                <uap:SplashScreen Image="Assets\logo.png"/>
            </uap:VisualElements>
            <Extensions>
                <desktop:Extension Category="windows.fullTrustProcess">
                    <desktop:FullTrustProcess/>
                </desktop:Extension>
            </Extensions>
        </Application>
    </Applications>


    <Capabilities>
        <rescap:Capability Name="runFullTrust"/>
        <rescap:Capability Name="broadFileSystemAccess"/>
    </Capabilities>

</Package>
