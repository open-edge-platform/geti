--- /dev/null
+++ b/src/utils/wasm-utils.tauri.ts
@@ -0,0 +1,35 @@
+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// Tauri build override, resolved via the `.tauri.*` extension list in rsbuild.config.ts.
+//
+// WebView2 honours COEP `credentialless`, so `crossOriginIsolated` is true and the
+// generic module would enable the threaded JSEP wasm. But emscripten spawns its pthread
+// pool as *nested module workers* (`new Worker(new URL(import.meta.url), {type:'module'})`
+// from inside the SAM worker), and those never load in the Tauri webview — ORT logs
+// "worker sent an error! undefined:undefined: undefined" and the runtime then blocks
+// forever on a pool that never comes up, blowing SAM_ENCODER_TIMEOUT_MS.
+//
+// Single-threaded CPU is the only path that completes. This is what macOS/Linux already
+// do implicitly (WKWebView/WebKitGTK report `crossOriginIsolated === false`); Windows
+// needs it stated explicitly. Do not import from `./wasm-utils` here — the `.tauri.*`
+// resolver would resolve that specifier back to this file.
+
+export interface SessionParameters {
+    numThreads: number;
+    executionProviders: string[];
+    wasmRoot: { wasm: string };
+}
+
+const wasmPaths = {
+    wasm: new URL(
+        '../../../../node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm',
+        import.meta.url
+    ).toString(),
+};
+
+export const sessionParams: SessionParameters = {
+    numThreads: 1,
+    executionProviders: ['cpu'],
+    wasmRoot: wasmPaths,
+};
